# Caminho público do app (build-time). Em dev, use /.
NUXT_APP_BASE_URL=/
# Vazio = mesma origem (window.location.origin) -> /finances e /users.
NUXT_PUBLIC_API_URL=
# Conversor externo de extrato PDF para OFX exibido na importação.
NUXT_PUBLIC_OFX_CONVERTER_URL=https://meuofx.com/
# OAuth Client ID (web) usado no botão "Entrar com Google". Vazio desabilita o botão.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
